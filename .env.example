# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control - it may contain secrets

# ====================
# FLASK CONFIGURATION
# ====================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production

# ====================
# SERVER CONFIGURATION
# ====================
HOST=localhost
PORT=5000

# ====================
# DATABASE CONFIGURATION
# ====================
# Uncomment and configure if using a database
# DATABASE_URL=sqlite:///tb_model.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tb_predictive_model
# DB_USER=postgres
# DB_PASSWORD=your-db-password

# ====================
# GOOGLE CLOUD CONFIGURATION
# ====================
# Google Cloud Storage
GCS_PROJECT_ID=your-gcs-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=path/to/credentials.json

# Google Earth Engine API
EARTHENGINE_API_KEY=your-earth-engine-api-key

# ====================
# MODEL CONFIGURATION
# ====================
MODEL_PATH=model/tb_model.joblib
DATA_PATH=data/kenya_counties.geojson

# ====================
# LOGGING CONFIGURATION
# ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ====================
# SECURITY CONFIGURATION
# ====================
# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ====================
# API CONFIGURATION
# ====================
# API rate limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ====================
# DEPLOYMENT CONFIGURATION
# ====================
# Heroku/Production settings
ENVIRONMENT=development
# ENVIRONMENT=production  # Uncomment for production

# Application URL (used for redirects, emails, etc.)
APP_URL=http://localhost:5000

# ====================
# OPTIONAL: EMAIL CONFIGURATION
# ====================
# If implementing email notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_DEFAULT_SENDER=noreply@tbpredictive.com
